{
  "name": "adaptive-learning-path",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "传智杯 AI WEB 网页开发挑战赛 · 自适应学习路径规划（B组 · 胆子肥嘟嘟队）",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-learning-e2e.mjs",
    "test:e2e:running": "tsx scripts/learning-smoke.ts",
    "kg:validate": "tsx scripts/validate-kg.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "bench": "node bench/bench-path.mjs",
    "smoke": "node scripts/run-learning-e2e.mjs",
    "smoke:mcp": "tsx scripts/mcp-smoke.ts",
    "smoke:auth": "tsx scripts/auth-smoke.ts",
    "probe:external": "tsx scripts/probe-external.ts",
    "eval:rag": "tsx scripts/eval-rag.ts",
    "eval:rag:hard": "tsx scripts/eval-rag-hard.ts",
    "verify": "npm run typecheck && npm run test && npm run kg:validate && npm run check:secrets && npm run eval:tutor",
    "path:hash": "tsx scripts/path-hash.ts",
    "eval:tutor": "tsx scripts/eval-tutor.ts",
    "prebuild": "node scripts/fetch-model.mjs --optional"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.152",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@xyflow/react": "^12.12.1",
    "ai": "6.0.312",
    "gsap": "3.15.0",
    "lucide-react": "1.71.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },

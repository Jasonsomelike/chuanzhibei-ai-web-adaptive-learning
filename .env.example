# 大模型接入（可选）
# 应用**不读取**下面的 DEEPSEEK_API_KEY / OPENAI_API_KEY：
# 供应商地址、密钥、模型名请在 /settings 保存（server 模式加密写入 user_secrets，
# 需要下方 ALP_SECRET_KEY；本机模式只存浏览器 localStorage）。
# 不配置任何供应商，系统仍完整可用：导师回答退化为知识库检索 + 题库解析的结构化拼装。

# 仅 scripts/probe-external.ts 真机探测使用；应用不读。
# 只有 base_url 主机是 api.deepseek.com 时，脚本才把该 key 当作 DeepSeek 官方搜索凭据。
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 同样不被应用读取；保留仅为提示可在 /settings 里填 OpenAI 兼容配置。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ────────────────────────────────────────────────────────────
# 数据库（线上必需）
# ────────────────────────────────────────────────────────────
# Postgres 连接串（postgres:// 或 postgresql:// 开头）。缺失或格式不符时
# 退化为进程内内存：重启即丢，且 /api/config 拒绝保存账号密钥
# （persistence_unavailable），不会把密文写进不持久的后端。
DATABASE_URL=

# ────────────────────────────────────────────────────────────
# 健康检查详细分支（可选）
# ────────────────────────────────────────────────────────────
# 配置后，GET /api/health 需带 Authorization: Bearer <token> 才额外返回
# keyEncryption 与 db 两个状态；不配时永远只回 {ok:true}，不暴露组件配置。
HEALTH_TOKEN=

# ────────────────────────────────────────────────────────────
# 服务端密钥加密（user_secrets 表）
# ────────────────────────────────────────────────────────────
# 32 字节随机数的标准 base64（44 字符，含 = 填充）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 缺失或格式不对时 /api/config 拒绝保存密钥（key_enc_unavailable），不会明文落库。
# 不要用口令、不要用 base64url、不要去掉末尾的 = 填充。
ALP_SECRET_KEY=
# 密钥版本号，轮换主密钥时修改；旧行会以 KEY_KID_UNKNOWN 报错，提示用户重存。
ALP_SECRET_KEY_ID=v1

# ────────────────────────────────────────────────────────────
# 服务端向量检索（可选，仅评测脚本与服务端兜底使用）
# ────────────────────────────────────────────────────────────
# 用户自己的 embedding 配置存在 user_secrets 的 llm 行 options 里；
# 这三项是服务端级兜底（例如 npm run eval:rag），三项必须同时给齐才生效。
# 缺省时向量检索自动退化为 BM25，不影响功能。
ALP_EMBED_BASE_URL=
ALP_EMBED_API_KEY=
ALP_EMBED_MODEL=

# ────────────────────────────────────────────────────────────
# 出站地址白名单（SSRF 防护）
# ────────────────────────────────────────────────────────────
# 允许服务端代理访问 http:// 主机的名单（逗号分隔 host[:port]）。
# 生产默认只放行 https；本地联调 http://localhost:11434 时填 localhost,127.0.0.1。
# 注意：命中名单即整体信任该主机——环回与内网地址会被放行（本地 Ollama 需要这么用）。
# 默认留空；未列出的内网地址一律拦截。http 条目必须带端口，例如 127.0.0.1:11434。
ALP_ALLOW_HTTP_PROVIDER_HOSTS=

# ────────────────────────────────────────────────────────────
# 仅本地测试
# ────────────────────────────────────────────────────────────
# 内存数据库没有持久化：允许写入密钥只用于单测，线上绝不要打开。
# 设 1 / true 放行；不设时 /api/config 在 memory 后端返回 persistence_unavailable。
ALP_ALLOW_MEMORY_SECRETS=

# ────────────────────────────────────────────────────────────
# 安全说明：
# 1. 本文件（.env.example）只放键名，不放真实值，可以提交。
# 2. 真实密钥写进 .env.local，该文件已在 .gitignore 中。
# 3. 仓库里任何位置都不得出现真实密钥，`npm run check:secrets` 会扫描。
# ────────────────────────────────────────────────────────────
